{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)",
    "customManagers:makefileVersions",
    "customManagers:githubActionsVersions"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "postUpdateOptions": ["gomodTidy"],
  "pre-commit": { "enabled": true },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "labels": ["security"] },
  "packageRules": [
    {
      "description": "Group all non-major npm updates together",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm (non-major)"
    },
    {
      "description": "SvelteKit majors and its adapters only work together.",
      "matchPackageNames": ["@sveltejs/kit", "@sveltejs/adapter-*"],
      "matchUpdateTypes": ["major"],
      "groupName": "sveltekit (major)"
    },
    {
      "description": "Group all non-major Go module updates together",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules (non-major)"
    },
    {
      "description": "Go major versions change the module path and need a code migration.",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["needs-migration"]
    },
    {
      "description": "Group Docker base-image digest/patch updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["digest", "pin", "patch"],
      "groupName": "docker base images"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
