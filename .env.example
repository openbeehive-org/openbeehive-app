# ============================================================================
# Openbeehive server configuration. Every runtime value the server uses is read
# from the environment (see server/internal/config). Copy to .env and adjust.
# Defaults shown are the built-in defaults; commented lines are optional.
#
# The server reads .env from its working directory at startup; variables that
# are already set in the environment win. `docker compose` reads the same file
# for the ${...} references in the compose files.
# ============================================================================

# ===== Deployment profile =====
# selfhost => SQLite + filesystem (single binary, no Docker needed)
# cloud    => PostgreSQL + MinIO
BEEHIVE_DEPLOYMENT_PROFILE=selfhost

# ===== HTTP server =====
BEEHIVE_ADDR=:8080
BEEHIVE_PUBLIC_BASE_URL=http://localhost:8080
# BEEHIVE_HTTP_READ_HEADER_TIMEOUT=10s
# BEEHIVE_HTTP_READ_TIMEOUT=2m         # per request; the live sync stream is exempt. 0 = no limit
# BEEHIVE_HTTP_WRITE_TIMEOUT=2m
# BEEHIVE_HTTP_IDLE_TIMEOUT=120s
# BEEHIVE_HTTP_SHUTDOWN_TIMEOUT=15s
# Behind a reverse proxy: take the client address (sign-in throttling) from the
# last X-Forwarded-For entry. Only set this when exactly one proxy you control
# sits in front and the server port is not reachable any other way.
# BEEHIVE_TRUST_PROXY_HEADERS=false
# Without login the server answers only to localhost, IP addresses and the
# host of BEEHIVE_PUBLIC_BASE_URL. List further host names here
# (comma-separated); "*" turns the check off.
# BEEHIVE_ALLOWED_HOSTS=

# ===== Embedded web app =====
BEEHIVE_SERVE_WEB=true                 # serve the embedded SPA (single-binary production)
# BEEHIVE_WEB_DIR=                     # serve this dir instead of the embedded build

# ===== CORS (only when the app is served from another origin than the API) =====
# Default: same-origin, no other site may call the API. List origins
# comma-separated, e.g. https://app.openbeehive.org. "*" allows any origin but
# never with credentials. With `make dev-app` set http://localhost:5173.
# BEEHIVE_CORS_ALLOWED_ORIGINS=
# BEEHIVE_CORS_ALLOW_CREDENTIALS=true

# ===== Maps =====
# Map tiles and address search are the only remote services the app contacts.
# "off" removes the map and the search; the URLs below are the defaults.
# BEEHIVE_MAPS=on
# BEEHIVE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# BEEHIVE_GEOCODER_URL=https://nominatim.openstreetmap.org

# ===== Sync =====
# Clock id stamped on server-side changes. Default: random at every start.
# Run exactly one server instance per database.
# BEEHIVE_NODE_ID=
# Days the change log is kept. Older entries are removed once a day; a device
# that was away longer loads the current data instead of the changes it missed.
# 0 keeps the log forever. Default: 180.
# BEEHIVE_CHANGELOG_RETENTION_DAYS=180
# Lowest sync protocol version accepted from apps. 0 (default) also accepts
# installed 0.4.x apps; 1 turns them away until they have updated.
# BEEHIVE_SYNC_MIN_PROTOCOL=0

# ===== Database (overrides the profile default) =====
# BEEHIVE_DATABASE_DRIVER=postgres|mysql|sqlite
# BEEHIVE_DATABASE_DSN=postgres://user:pass@host:5432/db?sslmode=disable
# BEEHIVE_DATABASE_DSN=user:pass@tcp(host:3306)/openbeehive?parseTime=true   # MySQL
# BEEHIVE_DATABASE_DSN=file:openbeehive.db?_pragma=journal_mode(WAL)         # SQLite

# ===== Blob storage =====
# BEEHIVE_BLOB_BACKEND=minio|fs
BEEHIVE_BLOB_DIR=./data/blobs
BEEHIVE_MINIO_ENDPOINT=localhost:9000
BEEHIVE_MINIO_ACCESS_KEY=minioadmin
BEEHIVE_MINIO_SECRET_KEY=minioadmin
BEEHIVE_MINIO_BUCKET=openbeehive
BEEHIVE_MINIO_USE_SSL=false

# ===== Auth: app session =====
# Required (32+ bytes) once any login method is enabled; the server refuses to
# start without it. Changing it signs everyone out.
# Generate: openssl rand -base64 32
BEEHIVE_SESSION_SECRET=
# BEEHIVE_SESSION_TTL=720h

# ===== Auth: WebAuthn / passkeys =====
BEEHIVE_WEBAUTHN_ENABLED=false
# BEEHIVE_WEBAUTHN_RP_ID=openbeehive.org                 # effective domain (default: host of PUBLIC_BASE_URL)
# BEEHIVE_WEBAUTHN_RP_ORIGINS=https://app.openbeehive.org # comma-separated allowed origins
# BEEHIVE_WEBAUTHN_RP_DISPLAY_NAME=Openbeehive

# ===== Auth: OIDC (multiple providers, comma-separated) =====
# Leave BEEHIVE_OIDC_PROVIDERS empty AND BEEHIVE_WEBAUTHN_ENABLED=false for self-host single-user
# mode (no login required). Set to enable login, e.g. BEEHIVE_OIDC_PROVIDERS=google,keycloak
# Every listed provider needs its issuer and client id, or the server refuses
# to start. A provider login is attached to an existing account only when the
# provider reports the email as verified and the account's email is verified.
BEEHIVE_OIDC_PROVIDERS=
# BEEHIVE_OIDC_REDIRECT_URL=http://localhost:8080/auth/callback   # default: <public base URL>/auth/callback

# BEEHIVE_OIDC_GOOGLE_ISSUER=https://accounts.google.com
# BEEHIVE_OIDC_GOOGLE_CLIENT_ID=
# BEEHIVE_OIDC_GOOGLE_CLIENT_SECRET=
# BEEHIVE_OIDC_GOOGLE_SCOPES=openid,profile,email

# Self-hosted IdP (Keycloak/Authentik)
# BEEHIVE_OIDC_KEYCLOAK_ISSUER=https://id.example.com/realms/openbeehive
# BEEHIVE_OIDC_KEYCLOAK_CLIENT_ID=openbeehive
# BEEHIVE_OIDC_KEYCLOAK_CLIENT_SECRET=

# ===== Onboarding: email + password (in-app users) =====
# Multi-user accounts without OIDC. Defaults: on for cloud, off for selfhost
# (single-user). Also implied by BEEHIVE_DEMO=true.
# BEEHIVE_PASSWORD_AUTH=true
# Dedicated instance admin — REQUIRED whenever password auth is enabled.
# Ensured on every boot: created if missing, role forced to admin, password
# reset to this value (doubles as password recovery). Sign-up never grants
# the admin role.
BEEHIVE_ADMIN_EMAIL=
BEEHIVE_ADMIN_PASSWORD=
# Open self-registration. false = invite-only: accounts can only be created
# via invite links (issued by the admin from Settings); the login screen
# shows an invite-only banner. Existing accounts sign in normally.
# BEEHIVE_REGISTRATION=true
# Require email verification before first sign-in (optional; needs SMTP below).
BEEHIVE_EMAIL_VERIFICATION=false
# SMTP for verification, invite and password-reset emails. Links are never
# written to the log: without SMTP, the admin copies an invite link from
# Settings, and only the instance admin can create a password-reset link
# there ("Reset a user's password") and hand it over.
# BEEHIVE_SMTP_HOST=
# BEEHIVE_SMTP_PORT=587
# BEEHIVE_SMTP_USER=
# BEEHIVE_SMTP_PASS=
# BEEHIVE_SMTP_FROM=Openbeehive <no-reply@openbeehive.org>

# ===== Demo tenant (showcase) =====
# Installs a demo account + tenant (15 hives, 4 apiaries), reset hourly. OFF by
# default. Enabling it implies BEEHIVE_PASSWORD_AUTH=true (so the admin vars
# above become required). The demo coexists with registration/invites: the
# login screen gets a "Try the demo" button next to the normal sign-in.
BEEHIVE_DEMO=false
# Sign anonymous visitors straight into the demo instead of showing the login
# screen — for pure-showcase hosts only.
# BEEHIVE_DEMO_AUTOLOGIN=false
# BEEHIVE_DEMO_EMAIL=demo@app.openbeehive.org
# BEEHIVE_DEMO_PASSWORD=demo
