{
  "name": "openbeehive-web",
  "private": true,
  "version": "0.5.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint . && jscpd",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "e2e": "playwright test",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --summary --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;(Apache-2.0 AND BSD-3-Clause)'",
    "unused": "knip --dependencies"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/leaflet": "1.9.22",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@lucide/svelte": "^1.77.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "svelte-i18n": "^4.0.1"
  },
  "overrides": {
    "svelte-i18n": {
      "esbuild": "^0.28.0"
    },
    "@axe-core/playwright": {
      "playwright-core": "$@playwright/test"
    },
    "minimatch": "^11.0.9"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
