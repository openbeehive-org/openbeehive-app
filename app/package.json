{
  "name": "openbeehive-web",
  "private": true,
  "version": "0.3.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --summary --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;(Apache-2.0 AND BSD-3-Clause)'",
    "unused": "knip --dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "knip": "^6.42.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "svelte-i18n": "^4.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "svelte-i18n": {
      "esbuild": "^0.25.0"
    }
  }
}
